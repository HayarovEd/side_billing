name: Deploy Side Billing to Server

# Триггер: запускать при пуше в ветку 'master'
on:
  push:
    branches:
      - master

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      # 1. Клонируем код репозитория
      - name: Checkout code
        uses: actions/checkout@v4

      # 2. Настраиваем Java (используйте вашу версию)
      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'

      # 3. Даем права на выполнение gradlew
      - name: Make gradlew executable
        run: chmod +x gradlew

      # 4. Собираем проект (ваша команда)
      - name: Build with Gradle
        run: ./gradlew clean build -x test

      # 5. Копируем JAR-файл на сервер
     - name: Copy JAR to server via SCP
       uses: appleboy/scp-action@v1
       with:
         host: ${{ secrets.SERVER_IP }}
         username: ${{ secrets.SERVER_USER }}
         key: ${{ secrets.SSH_PRIVATE_KEY }}
         port: ${{ secrets.SERVER_PORT }}
         source: "build/libs/side_billing-0.0.1-SNAPSHOT.jar"
         target: "/home/side_billing/temp/"
         strip_components: 2
         overwrite: true

     - name: Rename and move JAR file via SSH
       uses: appleboy/ssh-action@v1
       with:
         host: ${{ secrets.SERVER_IP }}
         username: ${{ secrets.SERVER_USER }}
         key: ${{ secrets.SSH_PRIVATE_KEY }}
         port: ${{ secrets.SERVER_PORT }}
         script: |
           mv /home/side_billing/temp/side_billing-0.0.1-SNAPSHOT.jar /home/side_billing/side_billing.jar
           rm -rf /home/side_billing/temp
           sudo systemctl restart side_billing

      # 6. Перезапускаем сервис на сервере
      - name: Restart application service via SSH
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.SERVER_IP }}
          username: ${{ secrets.SERVER_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          port: ${{ secrets.SERVER_PORT }}
          script: |
            sudo systemctl restart side_billing
            echo "Application restarted successfully."